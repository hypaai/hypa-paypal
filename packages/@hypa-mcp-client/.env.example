# @hypa/mcp-client environment (read by name only — never echo secret values)

# Hugging Face token for the chat/reasoning endpoint.
HF_API_KEY=hf_xxxxyyyzzzz

# MCP server this client connects to. Must include the /v2/mcp path.
# Default is http://localhost:5678/v2/mcp (the local hypa-api default port).
MCP_SERVER_URL=http://localhost:5678/v2/mcp

# Hugging Face chat endpoint this client calls for the agent loop.
# Default is the Hypa endpoint below (must match models.json); override when the endpoint ID changes.
HYPA_HF_BASE_URL=https://m35sn4lizhvy1v19.endpoints.huggingface.cloud/v1
