# PayPal sandbox only. The example refuses to start with anything else.
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# WhatsApp Cloud API (Meta). The number you send from, and the token that can send for it.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
# Any string you choose; paste the same one into Meta's webhook setup.
WHATSAPP_VERIFY_TOKEN=

# Any long random string. The merchant sends it to approve an order.
MERCHANT_TOKEN=
# Your tunnel's public HTTPS URL, for example from ngrok.
PUBLIC_URL=
PORT=3000
