{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "paths": {
      "@/*": ["./src/*"],
      "@hypa/config/*": ["../../packages/@hypa-config/*"],
      "sonner": ["../hypa-intelligence/node_modules/sonner"],
      "react-social-login-buttons": ["../hypa-intelligence/node_modules/react-social-login-buttons"],
      "@radix-ui/react-dialog": ["../hypa-intelligence/node_modules/@radix-ui/react-dialog"],
      "@radix-ui/react-dropdown-menu": ["../hypa-intelligence/node_modules/@radix-ui/react-dropdown-menu"],
      "@radix-ui/react-tooltip": ["../hypa-intelligence/node_modules/@radix-ui/react-tooltip"]
    },

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
