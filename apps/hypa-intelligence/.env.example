# The hypa-api backend this app talks to.
VITE_PUBLIC_API_URL=http://localhost:5678

# PostHog usage analytics. Leave VITE_POSTHOG_KEY empty to send nothing. The
# project API key (starts with phc_) is safe to ship in the browser bundle.
VITE_POSTHOG_KEY=
# https://us.i.posthog.com (US cloud, default) or https://eu.i.posthog.com
VITE_POSTHOG_HOST=https://us.i.posthog.com
