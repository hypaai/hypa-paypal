DATABASE_URL=postgresql://postgres:password@localhost:5432/hypa-v2?schema=public

REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DB=
REDIS_TLS=false

JWT_SECRET=your-secret-key-here
AGENT_MEDIA_SECRET=
# User id whose wallet pays for anonymous agent turns (POST /v2/agent, Lens and /v2/mcp). Keep its wallet funded.
# Without it anonymous callers get no tools and /v2/mcp needs a key.
AGENT_ANONYMOUS_USER_ID=
ENCRYPTION_KEY=your-32-byte-encryption-secret

# Shared anonymous MCP allowance per UTC day. Each tool POST reserves MCP_SPEND_CAP_USD.
# 0 disables anonymous tool calls; authenticated calls and tool listing still work.
MCP_ANONYMOUS_DAILY_BUDGET_USD=10

HYPA_API_KEY=your-huggingface-api-key
OPENAI_API_KEY=your-openai-api-key
META_MODEL_API_KEY=your-meta-model-api-key
RUNPOD_API_KEY=your-runpod-api-key
ASR_SEVERLESS_API_KEY=your-runpod-api-key

MANSA_API_KEY=msk_live_your-mansa-api-key
MANSA_MT_ENABLED=false
MANSA_ASR_ENABLED=false
MANSA_TTS_ENABLED=false

NODE_ENV=development
BASE_URL=http://localhost:5678

TRANSLATE_FREE_HYPA_ONLY=false
TRANSLATE_PAID_HYPA_ONLY=false

GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_OAUTH_STATE_SECRET=

FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"your-project-id","private_key_id":"key-id","private_key":"-----BEGIN PRIVATE KEY-----\nMIIEvQIBADANBgkqhkiG9w0BAQE...\n-----END PRIVATE KEY-----\n","client_email":"firebase-adminsdk@your-project-id.iam.gserviceaccount.com","client_id":"12345","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_x509_cert_url":"https://www.googleapis.com/robot/v1/metadata/x509/..."}


YARNGPT_API_KEY=

# PayPal Orders v2 (sandbox) and webhook signature verification
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_ENVIRONMENT=sandbox

# Web app origin for merchant approval links and the PayPal return page (/pay/:id)
FRONTEND_URL=http://localhost:5181
# Hypa Bridge on WhatsApp (WhatsApp Cloud API). Meta calls POST /v2/whatsapp/webhook; each message is checked
# against the app secret before anything is read. Each business's access token is stored encrypted in the database.
WHATSAPP_APP_SECRET=
# Any string you choose; paste the same one into Meta's webhook setup for the GET handshake.
WHATSAPP_VERIFY_TOKEN=
# "Connect WhatsApp" in the app (Embedded Signup): the Meta app's ID and the Embedded Signup configuration ID.
# WHATSAPP_APP_SECRET above is the app secret. Both unset → the app shows only the manual number ID and token fields.
META_APP_ID=
WHATSAPP_EMBEDDED_CONFIG_ID=
# Graph API version. Unset → v23.0.
WHATSAPP_GRAPH_VERSION=
# Local demos only: point the bridge at `pnpm --filter hypa-api whatsapp:sim` instead of Meta (http://localhost:4010).
WHATSAPP_GRAPH_URL=
# Model that writes Hypa Bridge replies, as provider/model. It must support tools. Unset → meta/muse-spark-1.3 (needs META_MODEL_API_KEY).
WHATSAPP_MODEL=
# Approved message template sent when a draft is approved after the customer's 24-hour window closed. Unset → quote_ready, en.
WHATSAPP_QUOTE_TEMPLATE=
WHATSAPP_QUOTE_TEMPLATE_LANGUAGE=
